# =============================================================================
# RuralHealth Connect — plantilla de configuración
#
# Copia este archivo a `.env` y rellena cada valor.
# `.env` esta en `.gitignore` y NO debe versionarse ni compartirse por chat,
# correo o mensajeria. Contiene las llaves que descifran la historia clinica.
#
# Genera cada secreto con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# --- Entorno -----------------------------------------------------------------
# development | testing | production
# En `production` la aplicacion NO arranca si falta cualquier secreto.
FLASK_ENV=development


# --- Base de datos -----------------------------------------------------------
# Desarrollo: sqlite:///ruralhealth.db
# Produccion: postgresql://usuario:clave@host:5432/basededatos
# En produccion se exige PostgreSQL; SQLite no soporta el bloqueo de filas
# que protege la dispensacion de medicamentos frente a entregas duplicadas.
SQLALCHEMY_DATABASE_URI=sqlite:///ruralhealth.db


# --- Secretos criptograficos -------------------------------------------------
# Firma de la cookie de sesion y de los hashes de orden medica.
RURALHEALTH_SECRET_KEY=

# Firma de los tokens JWT de la API.
RURALHEALTH_JWT_SECRET_KEY=

# Semilla de la que se deriva la clave Fernet que cifra PII e historia clinica.
#
#   PERDER ESTE VALOR SIGNIFICA PERDER TODOS LOS DATOS CLINICOS DE FORMA
#   IRREVERSIBLE. Guardalo en un gestor de secretos con copia de seguridad
#   fuera de linea antes del primer arranque en produccion.
#
RURALHEALTH_FIELD_KEY_SEED=

# Alternativa a la semilla: clave Fernet explicita (recomendado en produccion).
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RURALHEALTH_FIELD_ENCRYPTION_KEY=

# Pimienta del indice ciego que permite buscar por cedula sin almacenarla en claro.
# Cambiarlo invalida todas las busquedas por documento existentes.
RURALHEALTH_HASH_PEPPER=


# --- Cuentas iniciales -------------------------------------------------------
# Solo se usan en el primer arranque, para crear `superadmin` y `admin`.
# Ambas cuentas quedan marcadas para cambio obligatorio de contrasena
# en el primer inicio de sesion.
RURALHEALTH_SUPER_PASSWORD=
RURALHEALTH_ADMIN_PASSWORD=


# --- Limitacion de trafico ---------------------------------------------------
# Con varios workers hace falta almacenamiento compartido; en memoria cada
# worker lleva su propia cuenta y el limite real se multiplica por worker.
# Ejemplo: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://


# --- Servidor ----------------------------------------------------------------
PORT=5000

# Dominios permitidos como cabecera Host en produccion, separados por coma.
# Evita envenenamiento de cabecera Host en los enlaces de restablecimiento.
RURALHEALTH_ALLOWED_HOSTS=

# Ruta de almacenamiento de archivos subidos.
RURALHEALTH_UPLOAD_FOLDER=uploads

# Cuota total de subidas por clinica, en megabytes.
RURALHEALTH_CLINIC_UPLOAD_QUOTA_MB=512


# --- Interoperabilidad IHCE (Resolucion 1888 de 2025) ------------------------
# OBLIGATORIO para operar como prestador. Cada atencion debe remitirse como
# Resumen Digital de Atencion (RDA) a la plataforma nacional del Ministerio.
#
# Estas credenciales se obtienen en Hercules (SISPRO) despues de:
#   1. Registrar al prestador en Mi Seguridad Social
#   2. Designar formalmente un delegado
#   3. Inscribir al delegado en el modulo IHCE de Hercules
# Ver DEPLOYMENT.md, seccion 13.
#
# Mientras esten vacias los RDA se acumulan en la cola sin perderse, pero el
# prestador esta incumpliendo la Resolucion 1888.

# Tenant de Azure AD contra el que se pide el token.
IHCE_TENANT_ID=

# ClientID y ClientSecret de la aplicacion registrada. El secreto rota
# periodicamente por decision del Ministerio.
IHCE_CLIENT_ID=
IHCE_CLIENT_SECRET=

# Alcance del token OAuth2. Lo entrega el Ministerio con las credenciales.
IHCE_SCOPE=

# Clave de suscripcion del ambiente destino (header Ocp-Apim-Subscription-Key).
IHCE_SUBSCRIPTION_KEY=

# URL base del API. Cambia entre sandbox y produccion; la publica el Ministerio
# en el momento de entregar las credenciales. Sin barra final.
IHCE_BASE_URL=

# Codigo de habilitacion del prestador en REPS, y numero de sede.
IHCE_HABILITACION=
IHCE_SEDE=00

# Permite suspender la transmision sin borrar credenciales, por ejemplo durante
# una ventana de mantenimiento del Ministerio. Vacio o 1 = activa.
IHCE_ENABLED=1

# Tiempo maximo de espera por peticion, en segundos.
IHCE_TIMEOUT=30
