# --- Secretos: NUNCA versionar ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Datos de pacientes: NUNCA versionar ---
uploads/
instance/
*.db
*.sqlite
*.sqlite3
logs/
*.log

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Sistema ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# --- Build de estilos ---
# node_modules solo hace falta para regenerar el CSS.
node_modules/
package-lock.json

# static/css/app.css SI se versiona: sin el, ejecutar la aplicacion
# exigiria Node y conexion, que es justo lo que se queria evitar.

# --- Recorrido de la interfaz ---
# Las capturas se regeneran con scripts/recorrido/capturar.py. Son 21 MB de
# PNG que cambian con cada retoque de estilo: versionarlas engorda el
# historial sin aportar nada que no se pueda reconstruir en un minuto.
capturas/

# --- Entregables en PDF ---
# El Markdown es la fuente; el PDF se regenera con
# `python entregables/generar_pdf.py` en segundos. Versionar binarios que
# cambian con cada retoque de texto ensucia el historial sin aportar nada.
entregables/**/*.pdf
